NODE_ENV=development
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=app
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional bot credentials for future notifications, NOT used by Telegram Login JS/OIDC.
TG_BOT_TOKEN=
TG_BOT_NAME=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
# Legacy config keys retained; refresh sessions now use opaque tokens, not JWT.
JWT_REFRESH_SECRET=unused-legacy-refresh-secret
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=30
FRONTEND_URL=http://localhost:5173
AUTH_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_CIDRS=
COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_ACCESS_SECONDS=900
AUTH_SESSION_SECONDS=2592000
AUTH_VERIFY_SECONDS=86400
AUTH_RESET_SECONDS=1800
# Telegram Login JS callback ID token. Client Secret is NOT needed for this flow.
TELEGRAM_CLIENT_ID=12345678
TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
TELEGRAM_ATTEMPT_SECONDS=300
TELEGRAM_TOKEN_MAX_AGE_SECONDS=300
TELEGRAM_JWKS_TIMEOUT_MS=2000
TELEGRAM_JWKS_COOLDOWN_MS=30000
TELEGRAM_JWKS_CACHE_MS=600000
TELEGRAM_JWKS_REQUESTS_PER_MINUTE=10
TELEGRAM_START_IP_LIMIT=20
TELEGRAM_COMPLETE_IP_LIMIT=60
AUTH_EARLY_IP_LIMIT=180
AUTH_REFRESH_DUPLICATE_SECONDS=5
AUTH_LIMIT_WINDOW_SECONDS=900
AUTH_LIMIT_REGISTER=5
AUTH_LIMIT_LOGIN=10
AUTH_LIMIT_RESEND=5
AUTH_LIMIT_FORGOT=5
AUTH_LIMIT_REFRESH=60
AUTH_LIMIT_TOKEN=10
AUTH_LIMIT_TELEGRAM=10
AUTH_MAIL_COOLDOWN_SECONDS=60
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
# Chosen Postbox auth: API-key ID and its secret part (scope yc.postbox.send).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=Игры для вышивальщиц
# Dedicated disposable DB, used only by test:auth (never use the application DB).
# AUTH_TEST_DATABASE_URL=postgresql://auth_test:auth_test_local_only@127.0.0.1:55439/auth_test
